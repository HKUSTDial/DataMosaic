DOCPILOT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DBMOSAIC_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Unified portal. Keep loopback unless a trusted LAN is protected by a firewall/auth proxy.
DATAMOSAIC_WEB_BIND=127.0.0.1
DATAMOSAIC_WEB_PORT=8080

# DocPilot model settings are read only by the API container, never sent to the browser.
DOCPILOT_PROVIDER=custom
DOCPILOT_MODEL_BASE_URL=https://api.openai.com/v1
DOCPILOT_MODEL=
DOCPILOT_API_KEY=
DOCPILOT_REASONING=false

# DBMosaic reads its provider key from module/DBMosaic/llm/.env.
DBMOSAIC_MODEL=gpt-4o

# OntoMosaic-Text2SQL. Model credentials live in the engine's untracked .env.
# Paths are relative to this portal checkout; absolute paths are also supported.
ONTOLOGY_SOURCE=./module/Ontology-NL2SQL
ONTOLOGY_ENV_FILE=./module/Ontology-NL2SQL/.env
ONTOLOGY_DATABASES=./module/Ontology-NL2SQL/data/web_databases
# Upstream used by Vite and the local gateway (Docker uses ontology:8011).
ONTOLOGY_URL=http://127.0.0.1:8011
ENABLE_ONTOLOGY=1
