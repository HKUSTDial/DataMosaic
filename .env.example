DOCPILOT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATAMOSAIC_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Unified portal. Keep loopback unless a trusted LAN is protected by a firewall/auth proxy.
DOCSENSA_WEB_BIND=127.0.0.1
DOCSENSA_WEB_PORT=8080

# DocPilot model settings are read only by the API container, never sent to the browser.
DOCPILOT_PROVIDER=custom
DOCPILOT_MODEL_BASE_URL=https://api.openai.com/v1
DOCPILOT_MODEL=
DOCPILOT_API_KEY=
DOCPILOT_REASONING=false

# DataMosaic reads its provider key from .local/DataMosaic/llm/.env.
DATAMOSAIC_MODEL=gpt-4o
