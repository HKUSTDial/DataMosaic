{
  "name": "@datamosaic/dsh-docmosaic",
  "version": "0.1.0",
  "description": "Document questions and source evidence through the existing DocMosaic service.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.mjs", "cordis.patch.yml", "mcp", "skills", "locale", "icon.svg", "README.md"],
  "icon": "./icon.svg",
  "engines": { "node": ">=24.9.0", "dsh": "0.2.1-rc.2" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "start": "node mcp/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.mjs && node --check mcp/client.mjs && node --check mcp/server.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  }
}
